    "def l(Theta):\n",
    "    return (1 - Theta[0])**2 + 10 * (Theta[1] - Theta[0]**2)**2\n",
    "\n",
    "def gradient(Theta):\n",
    "    g1 = -2 * (1 - Theta[0]) - 40 * Theta[0] * (Theta[1] - Theta[0]**2)\n",
    "    g2 = 20 * (Theta[1] - Theta[0]**2)\n",
    "    return np.array([g1, g2])"
   ]
  },
